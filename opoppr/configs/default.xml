<?xml version="1.0" encoding="UTF-8"?>
<Context antiJARLocking="true" path="/opoppr">
    <Resource auth="Container" driverClassName="com.mysql.jdbc.Driver" initialSize="5" logAbandoned="true" maxActive="50" maxIdle="15" maxWait="60000" name="jdbc/OPOPPR" password="opoppr" removeAbandoned="true" type="javax.sql.DataSource" url="jdbc:mysql://localhost:3306/opoppr?zeroDateTimeBehavior=convertToNull" username="opoppr" validationQuery="SELECT 1 FROM DUAL"/>
    <Resource auth="Container" mail.smtp.host="localhost" name="mail/Session" type="javax.mail.Session"/>
    <Manager pathname=""/>
    <!-- disables storage of sessions across restarts -->
    <Resource auth="Container" factory="org.jboss.weld.resources.ManagerObjectFactory" name="BeanManager" type="javax.enterprise.inject.spi.BeanManager"/>
    <!-- Uncomment to enable injection into Servlet -->
    <!-- <Listener className="org.jboss.weld.environment.tomcat.WeldLifecycleListener"/> -->
    <Realm className="org.apache.catalina.realm.DataSourceRealm"
       dataSourceName="jdbc/OPOPPR"
       userTable="account" userNameCol="BILL_NUMBER" userCredCol="PIN"
       userRoleTable="account" roleNameCol="BILL_NUMBER"
       localDataSource="true" />
</Context>
