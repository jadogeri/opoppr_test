    <class>com.svlogic.opoppr.model.NoaPpLat5Filing</class>
    <class>com.svlogic.opoppr.model.Status</class>
    <class>com.svlogic.opoppr.model.Form</class>
    <class>com.svlogic.opoppr.model.User</class>
    <class>com.svlogic.opoppr.model.UserRole</class>
    <class>com.svlogic.opoppr.model.UserChangeType</class>
    <class>com.svlogic.opoppr.model.UserChange</class>
    <class>com.svlogic.opoppr.model.BusinessType</class>
    <class>com.svlogic.opoppr.model.UserStatus</class>
    <exclude-unlisted-classes>false</exclude-unlisted-classes>
