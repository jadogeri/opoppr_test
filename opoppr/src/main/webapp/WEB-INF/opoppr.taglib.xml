<?xml version="1.0" encoding="UTF-8"?>
<facelet-taglib version="3.0"
    xmlns="https://jakarta.ee/xml/ns/jakartaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
    https://jakarta.ee/xml/ns/jakartaee/web-facelettaglibrary_3_0.xsd">
    <namespace>http://opoppr.svlogic.com/ui</namespace>
    <tag>
        <tag-name>disablePanel</tag-name>
        <component>
            <component-type>com.svlogic.opoppr.tag.UIDisablePanel</component-type>
        </component>
        <attribute>
            <name>disabled</name>
            <required>true</required>
        </attribute>
    </tag>
    <tag>
        <tag-name>convertMask</tag-name>
        <converter>
            <converter-id>com.svlogic.opoppr.converter.Mask</converter-id>
        </converter>
        <attribute>
            <name>mask</name>
            <required>true</required>
        </attribute> 
    </tag>
    <tag>
        <tag-name>validateEquals</tag-name>
        <validator>
            <validator-id>com.svlogic.opoppr.validator.Equals</validator-id>
        </validator>
        <attribute>
            <name>to</name>
            <required>true</required>
        </attribute>
    </tag>
    <tag>
        <tag-name>validateEmail</tag-name>
        <validator>
            <validator-id>com.svlogic.opoppr.validator.Email</validator-id>
        </validator>
        <attribute>
            <name>notRequired</name>
            <type>boolean</type>
        </attribute>
    </tag>
    <tag>
        <tag-name>validatePhoneNumber</tag-name>
        <validator>
            <validator-id>com.svlogic.opoppr.validator.PhoneNumber</validator-id>
        </validator>
        <attribute>
            <name>notRequired</name>
            <type>boolean</type>
        </attribute>
    </tag>
    <tag>
        <tag-name>validatePassword</tag-name>
        <validator>
            <validator-id>com.svlogic.opoppr.validator.Password</validator-id>
        </validator>
        <attribute>
            <name>notRequired</name>
            <type>boolean</type>
        </attribute>
    </tag>
    <tag>
        <tag-name>validateUsername</tag-name>
        <validator>
            <validator-id>com.svlogic.opoppr.validator.Username</validator-id>
        </validator>
        <attribute>
            <name>notRequired</name>
            <type>boolean</type>
        </attribute>
    </tag>
    <tag>
        <tag-name>validateFullName</tag-name>
        <validator>
            <validator-id>com.svlogic.opoppr.validator.FullName</validator-id>
        </validator>
        <attribute>
            <name>notRequired</name>
            <type>boolean</type>
        </attribute>
    </tag>
</facelet-taglib>
